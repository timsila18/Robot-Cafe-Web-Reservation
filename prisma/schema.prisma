generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  CANCELLATION_REQUESTED
  MODIFICATION_REQUESTED
}

model Branch {
  id                    String        @id
  name                  String
  shortName             String
  address               String
  reservationInbox      String
  reservationRoutingLabel String
  diaryPlaceName        String?
  active                Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  reservations          Reservation[]
  surveyResponses       SurveyResponse[]

  @@map("branches")
}

model Customer {
  id           String        @id @default(cuid())
  firstName    String
  lastName     String
  phone        String
  email        String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  reservations Reservation[]

  @@unique([email, phone])
  @@map("customers")
}

model Reservation {
  id                 String            @id @default(cuid())
  confirmationNumber String            @unique
  branchId           String
  customerId         String?
  guests             Int
  date               DateTime
  selectedTime       String
  status             ReservationStatus @default(PENDING)
  preferences        String[]          @default([])
  notes              String?
  source             String            @default("website")
  routingInbox       String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  branch             Branch            @relation(fields: [branchId], references: [id])
  customer           Customer?         @relation(fields: [customerId], references: [id])

  @@index([branchId, status, date])
  @@index([confirmationNumber])
  @@map("reservations")
}

model SurveyResponse {
  id                    String   @id @default(cuid())
  branchId              String
  tableCode             String?
  source                String   @default("qr")
  priceRating           Int
  priceTags             String[] @default([])
  waiterServiceRating   Int
  waiterServiceTags     String[] @default([])
  robotExperienceRating Int
  robotExperienceTags   String[] @default([])
  ambienceRating        Int
  ambienceTags          String[] @default([])
  foodFlavorRating      Int
  foodFlavorTags        String[] @default([])
  foodValueRating       Int
  foodValueTags         String[] @default([])
  foodPortionRating     Int
  foodPortionTags       String[] @default([])
  overallRating         Int
  comment               String?
  createdAt             DateTime @default(now())
  branch                Branch   @relation(fields: [branchId], references: [id])

  @@index([branchId, createdAt])
  @@index([createdAt])
  @@map("survey_responses")
}
